POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=toBeModified

# App de veille cyber : mot de passe de connexion (8 caractères minimum)
VEILLE_PASSWORD=toBeModified
# Optionnel : clé API NVD (gratuite) pour des limites de débit plus larges
NVD_API_KEY=

# Mot de passe devant cms.marleyportfolio.fr/admin (basic_auth Caddy).
# Hash : docker run --rm caddy:2-alpine caddy hash-password --plaintext 'ton-mot-de-passe'
# Garder les apostrophes : le hash bcrypt contient des $ que Compose interpréterait.
CMS_ADMIN_USER=marley
CMS_ADMIN_HASH='$2a$14$remplacer.par.le.hash.genere'
